{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"], "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts", "packages/**/*.ts", "apps/server/src/**/*.ts", "apps/web/src/**/*.ts"]
}
