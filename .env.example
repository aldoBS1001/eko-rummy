# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
NODE_ENV=production
DOMAIN=juego.ekokiin.com
PUBLIC_URL=https://juego.ekokiin.com
PORT=8080
# Secreto para firmar sesiones: 64 caracteres aleatorios (openssl rand -hex 32)
AUTH_SECRET=
# Usuarios que reciben rol de administrador al iniciar sesión (separados por coma)
ADMIN_USERS=
DB_PATH=/data/eko-rummy.sqlite
TURN_SECONDS=90
RECONNECT_GRACE_SECONDS=60
QUICK_MATCH_BOT_FILL_SECONDS=30

# Stripe (usar claves sk_test_ hasta aprobar producción)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_APPROVED=false

# TRON (solo lectura)
TRON_NETWORK=mainnet
TRON_API_KEY=
EKOKIIN_CONTRACT=TMNKYEbXGJGFPaZXs8tBER6gMiRvjKtUiU

# Módulo económico: permanece bloqueado aunque esto sea true si faltan aprobaciones en COMPLIANCE_FILE
BETTING_ENABLED=false
COMPLIANCE_FILE=/app/compliance/approvals.json

# KYC con Sumsub (Panel de Sumsub › Dev space › App tokens). Sin estas claves la verificación aparece como "no disponible".
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
# Secreto del webhook (Dev space › Webhooks) apuntando a https://TU-DOMINIO/api/kyc/webhook
SUMSUB_WEBHOOK_SECRET=
# Nivel de verificación creado en Sumsub (identificación + selfie con prueba de vida)
SUMSUB_LEVEL_NAME=basic-kyc-level
