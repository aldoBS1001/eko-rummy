{
  "name": "EKO RUMMY",
  "short_name": "EKO RUMMY",
  "description": "Juego de fichas de Business Shop y EKO K'iin: gratis contra la IA, multijugador, equipos y torneos.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b3326",
  "theme_color": "#0b3326",
  "lang": "es",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Jugar contra la IA", "url": "./#/jugar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Multijugador", "url": "./#/multijugador", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
